# Copy to .env and fill in real values before `docker compose up`.

# Required: HMAC secret for signing download URLs. Anything random + long.
# Generate with: openssl rand -hex 32
LIVEC_SIGNING_SECRET=replace_me_with_64_random_hex_chars

# Optional: relay listen port (default 3000). Match whatever your reverse
# proxy / cloudflared tunnel forwards to.
# PORT=3000
