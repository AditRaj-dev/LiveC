{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveC",
  "version": "0.1.0",
  "identifier": "com.livec.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LiveC",
        "width": 1000,
        "height": 700
      },
      {
        "label": "overlay",
        "title": "DropShelf",
        "width": 360,
        "height": 360,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "url": "/#/overlay"
      },
      {
        "label": "screenshot_toast",
        "title": "Screenshot Toast",
        "width": 420,
        "height": 320,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "url": "/#/toast"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
